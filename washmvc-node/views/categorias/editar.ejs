<%- include('../partials/header') %>
<div class="page-header"><div><h1>Editar Categoria</h1><p>#<%= categoria.id %></p></div>
  <a href="/categorias" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Voltar</a>
</div>
<div class="card" style="max-width:480px"><div class="card-body">
  <% if (errors.geral) { %><div class="alert alert-danger"><%= errors.geral %></div><% } %>
  <form action="/categorias/editar/<%= categoria.id %>" method="POST">
    <div class="mb-4"><label class="form-label">Nome</label>
      <input name="nome" class="form-control" value="<%= categoria.nome || '' %>" />
      <% if (errors.nome) { %><div class="text-danger small"><%= errors.nome %></div><% } %>
    </div>
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">Salvar</button>
      <a href="/categorias" class="btn btn-outline-secondary">Cancelar</a>
    </div>
  </form>
</div></div>
<%- include('../partials/footer') %>
