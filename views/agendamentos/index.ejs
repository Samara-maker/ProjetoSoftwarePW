<%- include('../partials/header') %>
  <div class="page-header">
    <div>
      <h1>Agendamentos</h1>
      <p>
        <%= agendamentos.length %> agendamento(s) cadastrado(s)
      </p>
    </div>
    <a href="/agendamentos/criar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Novo Agendamento</a>
  </div>
  <div class="card">
    <div class="card-body p-0">
      <% if (!agendamentos.length) { %>
        <div class="empty-state"><i class="bi bi-calendar-check"></i>
          <p>Nenhum agendamento cadastrado ainda.</p>
        </div>
        <% } else { %>
          <table class="table mb-0">
            <thead>
              <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Data</th>
                <th>Horário</th>
                <th>Responsável</th>
                <th>Status</th>
                <th>Serviços</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% agendamentos.forEach(function(a) { %>
                <tr>
                  <td class="text-muted">#<%= a.id %>
                  </td>
                  <td>
                    <%= a.cliente ? a.cliente.nome : '—' %>
                  </td>
                  <td>
                    <%= new Date(a.data).toLocaleDateString('pt-BR', {timeZone:'UTC'}) %>
                  </td>
                  <td class="text-nowrap">
                    <%= a.horarioInicio %> – <%= a.horarioFim %>
                  </td>
                  <td>
                    <% if (a.funcionario) { %>
                      <%= a.funcionario.nome %>
                        <% } else if (a.equipe) { %>
                          <%= a.equipe.nome %>
                            <% } else { %><span class="text-muted">—</span>
                              <% } %>
                  </td>
                  <td><span class="badge-status <%= a.status.toLowerCase() %>">
                      <%= a.status %>
                    </span></td>
                  <td>
                    <% if (a.agendamentoServicos && a.agendamentoServicos.length) { %>
                      <span class="badge bg-light text-secondary border">
                        <%= a.agendamentoServicos.length %> serviço(s)
                      </span>
                      <% } %>
                  </td>
                  <td class="text-end">
                    <a href="/agendamentos/editar/<%= a.id %>" class="btn-icon edit me-1"><i
                        class="bi bi-pencil"></i></a>
                    <a href="/agendamentos/excluir/<%= a.id %>" class="btn-icon trash"><i class="bi bi-trash"></i></a>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
          <% } %>
    </div>
  </div>
  <%- include('../partials/footer') %>