<%- include('../partials/header') %>
  <div class="page-header">
    <div>
      <h1>Novo Funcionário</h1>
    </div>
    <a href="/funcionarios" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Voltar</a>
  </div>
  <div class="card" style="max-width:560px">
    <div class="card-body">
      <% if (errors.geral) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>
          <%= errors.geral %>
        </div>
        <% } %>
          <form action="/funcionarios/criar" method="POST">
            <div class="mb-3"><label class="form-label">Nome</label>
              <input name="nome" class="form-control" value="<%= data.nome || '' %>" placeholder="Nome completo" />
              <% if (errors.nome) { %>
                <div class="text-danger small">
                  <%= errors.nome %>
                </div>
                <% } %>
            </div>
            <div class="mb-4"><label class="form-label">Cargo</label>
              <input name="cargo" class="form-control" value="<%= data.cargo || '' %>" placeholder="Ex: Lavador" />
              <% if (errors.cargo) { %>
                <div class="text-danger small">
                  <%= errors.cargo %>
                </div>
                <% } %>
            </div>
            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">Salvar</button>
              <a href="/funcionarios" class="btn btn-outline-secondary">Cancelar</a>
            </div>
          </form>
    </div>
  </div>
  <%- include('../partials/footer') %>