<%- include('../layouts/partials/header') %>

  <div class="page-header">
    <div>
      <h1>Clientes</h1>
      <p><%= clientes.length %> cliente(s) cadastrado(s)</p>
    </div>
    <a href="/clientes/criar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Novo Cliente</a>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <% if (!clientes.length) { %>
        <div class="empty-state"><i class="bi bi-people"></i>
          <p>Nenhum cliente cadastrado ainda.</p>
        </div>
      <% } else { %>
        <table class="table mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Telefone</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% clientes.forEach(c => { %>
              <tr>
                <td class="text-muted">#<%= c.id %></td>
                <td class="fw-500"><%= c.nome %></td>
                <td><%= c.email || '-' %></td>
                <td><%= c.telefone || '-' %></td>
                <td class="text-end">
                  <a href="/clientes/<%= c.id %>/editar" class="btn-icon edit me-1" title="Editar"><i class="bi bi-pencil"></i></a>
                  <a href="/clientes/<%= c.id %>/excluir" class="btn-icon trash" title="Excluir"><i class="bi bi-trash"></i></a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

<%- include('../layouts/partials/footer') %>
