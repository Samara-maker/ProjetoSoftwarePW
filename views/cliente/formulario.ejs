<%- include('../layouts/partials/header') %>
<% const erros = validationErrors(locals.errors); %>
<% const cliente = locals.cliente || {} %>

  <div class="page-header">
    <div>
      <h1><%= locals.titulo %></h1>
      <% if (cliente.id) { %><p>#<%= cliente.id %></p><% } %>
    </div>
    <a href="/clientes" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Voltar</a>
  </div>

  <div class="card" style="max-width:560px">
    <div class="card-body">
      <% if (erros.all.length) { %>
        <div class="alert alert-danger">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <ul class="mb-0 mt-1">
            <% erros.all.forEach(m => { %><li><%= m %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/clientes/<%= cliente.id ? cliente.id + '/editar' : 'criar' %>" method="POST">
        <div class="mb-3">
          <label class="form-label">Nome</label>
          <input name="nome" class="form-control <%= erros.has('nome') ? 'is-invalid' : '' %>"
            value="<%= cliente.nome || '' %>" placeholder="Nome completo" />
          <% if (erros.has('nome')) { %>
            <div class="text-danger small"><%= erros.get('nome')[0] %></div>
          <% } %>
        </div>
        <div class="mb-3">
          <label class="form-label">E-mail</label>
          <input name="email" type="email" class="form-control"
            value="<%= cliente.email || '' %>" placeholder="email@exemplo.com" />
        </div>
        <div class="mb-4">
          <label class="form-label">Telefone</label>
          <input name="telefone" class="form-control"
            value="<%= cliente.telefone || '' %>" placeholder="(00) 00000-0000" />
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">Salvar</button>
          <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>

<%- include('../layouts/partials/footer') %>
