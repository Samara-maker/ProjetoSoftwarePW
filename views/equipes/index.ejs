<%- include('../partials/header') %>
<div class="page-header">
  <div><h1>Equipes</h1><p><%= equipes.length %> equipe(s) cadastrada(s)</p></div>
  <a href="/equipes/criar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Nova Equipe</a>
</div>
<div class="card"><div class="card-body p-0">
  <% if (!equipes.length) { %>
    <div class="empty-state"><i class="bi bi-people-fill"></i><p>Nenhuma equipe cadastrada ainda.</p></div>
  <% } else { %>
    <table class="table mb-0">
      <thead><tr><th>#</th><th>Nome</th><th></th></tr></thead>
      <tbody>
        <% equipes.forEach(function(e) { %>
          <tr>
            <td class="text-muted">#<%= e.id %></td><td><%= e.nome %></td>
            <td class="text-end">
              <a href="/equipes/editar/<%= e.id %>" class="btn-icon edit me-1"><i class="bi bi-pencil"></i></a>
              <a href="/equipes/excluir/<%= e.id %>" class="btn-icon trash"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div></div>
<%- include('../partials/footer') %>
