<%- include('../layouts/partials/header') %>

  <div class="page-header">
    <div>
      <h1>Serviços</h1>
      <p><%= servicos.length %> serviço(s) cadastrado(s)</p>
    </div>
    <a href="/servicos/criar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Novo Serviço</a>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <% if (!servicos.length) { %>
        <div class="empty-state"><i class="bi bi-wrench-adjustable"></i>
          <p>Nenhum serviço cadastrado ainda.</p>
        </div>
      <% } else { %>
        <table class="table mb-0">
          <thead>
            <tr><th>#</th><th>Descrição</th><th>Categoria</th><th>Valor</th><th></th></tr>
          </thead>
          <tbody>
            <% servicos.forEach(s => { %>
              <tr>
                <td class="text-muted">#<%= s.id %></td>
                <td class="fw-500"><%= s.descricao %></td>
                <td><%= s.categoria ? s.categoria.nome : '-' %></td>
                <td><%= moneyFormat(s.valor) %></td>
                <td class="text-end">
                  <a href="/servicos/<%= s.id %>/editar" class="btn-icon edit me-1"><i class="bi bi-pencil"></i></a>
                  <a href="/servicos/<%= s.id %>/excluir" class="btn-icon trash"><i class="bi bi-trash"></i></a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

<%- include('../layouts/partials/footer') %>
