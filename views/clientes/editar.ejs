<%- include('../partials/header') %>

  <div class="page-header">
    <div>
      <h1>Editar Cliente</h1>
      <p>#<%= cliente.id %>
      </p>
    </div>
    <a href="/clientes" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Voltar</a>
  </div>

  <div class="card" style="max-width:560px">
    <div class="card-body">
      <% if (errors.geral) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>
          <%= errors.geral %>
        </div>
        <% } %>
          <form action="/clientes/editar/<%= cliente.id %>" method="POST">
            <div class="mb-3">
              <label class="form-label">Nome</label>
              <input name="nome" class="form-control <%= errors.nome ? 'is-invalid' : '' %>"
                value="<%= cliente.nome || '' %>" />
              <% if (errors.nome) { %>
                <div class="text-danger small">
                  <%= errors.nome %>
                </div>
                <% } %>
            </div>
            <div class="mb-3">
              <label class="form-label">E-mail</label>
              <input name="email" type="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>"
                value="<%= cliente.email || '' %>" />
              <% if (errors.email) { %>
                <div class="text-danger small">
                  <%= errors.email %>
                </div>
                <% } %>
            </div>
            <div class="mb-4">
              <label class="form-label">Telefone</label>
              <input name="telefone" class="form-control <%= errors.telefone ? 'is-invalid' : '' %>"
                value="<%= cliente.telefone || '' %>" />
              <% if (errors.telefone) { %>
                <div class="text-danger small">
                  <%= errors.telefone %>
                </div>
                <% } %>
            </div>
            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">Salvar</button>
              <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
            </div>
          </form>
    </div>
  </div>

  <%- include('../partials/footer') %>