<%- include('../partials/header') %>

<div class="page-header">
  <div><h1>Excluir Cliente</h1></div>
  <a href="/clientes" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Voltar</a>
</div>

<div class="card-danger" style="max-width:480px">
  <div class="card-header-danger"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar exclusão</div>
  <div class="card-body p-4">
    <p>Tem certeza que deseja excluir o cliente <strong><%= cliente.nome %></strong>?</p>
    <p class="text-muted small">Esta ação não poderá ser desfeita.</p>
    <form action="/clientes/excluir/<%= cliente.id %>" method="POST" class="d-flex gap-2">
      <button type="submit" class="btn btn-danger">Sim, excluir</button>
      <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
