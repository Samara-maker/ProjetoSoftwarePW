<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — WashMvc</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css" />
</head>
<body>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <i class="bi bi-droplet-fill text-primary"></i>
    <span>WashMvc</span>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section-label">Principal</div>
    <a href="/" class="nav-link-item <%= controller === 'Home' ? 'active' : '' %>">
      <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
    </a>

    <div class="nav-section-label mt-3">Cadastros</div>
    <a href="/clientes" class="nav-link-item <%= controller === 'Clientes' ? 'active' : '' %>">
      <i class="bi bi-people"></i> <span>Clientes</span>
    </a>
    <a href="/funcionarios" class="nav-link-item <%= controller === 'Funcionarios' ? 'active' : '' %>">
      <i class="bi bi-person-badge"></i> <span>Funcionários</span>
    </a>
    <a href="/equipes" class="nav-link-item <%= controller === 'Equipes' ? 'active' : '' %>">
      <i class="bi bi-people-fill"></i> <span>Equipes</span>
    </a>

    <div class="nav-section-label mt-3">Serviços</div>
    <a href="/categorias" class="nav-link-item <%= controller === 'Categorias' ? 'active' : '' %>">
      <i class="bi bi-tags"></i> <span>Categorias</span>
    </a>
    <a href="/servicos" class="nav-link-item <%= controller === 'Servicos' ? 'active' : '' %>">
      <i class="bi bi-wrench-adjustable"></i> <span>Serviços</span>
    </a>

    <div class="nav-section-label mt-3">Operações</div>
    <a href="/agendamentos" class="nav-link-item <%= controller === 'Agendamentos' ? 'active' : '' %>">
      <i class="bi bi-calendar-check"></i> <span>Agendamentos</span>
    </a>
  </nav>
</div>

<!-- Main -->
<div class="main-content" id="main-content">
  <div class="topbar">
    <button class="btn btn-link text-secondary p-0 me-3" id="sidebarToggle">
      <i class="bi bi-list fs-5"></i>
    </button>
    <nav aria-label="breadcrumb" class="d-none d-md-block">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Início</a></li>
        <li class="breadcrumb-item active"><%= title %></li>
      </ol>
    </nav>
    <div class="ms-auto d-flex align-items-center gap-2">
      <span class="badge bg-light text-secondary border">localhost</span>
    </div>
  </div>

  <!-- Alerts -->
  <div class="px-4 pt-3">
    <% if (typeof sucesso !== 'undefined' && sucesso && sucesso.length) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= sucesso[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (typeof erro !== 'undefined' && erro && erro.length) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= erro[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
  </div>

  <div class="page-content">
