<%- include('../partials/header') %>
  <div class="page-header">
    <div>
      <h1>Categorias</h1>
      <p>
        <%= categorias.length %> categoria(s) cadastrada(s)
      </p>
    </div>
    <a href="/categorias/criar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Nova Categoria</a>
  </div>
  <div class="card">
    <div class="card-body p-0">
      <% if (!categorias.length) { %>
        <div class="empty-state"><i class="bi bi-tags"></i>
          <p>Nenhuma categoria cadastrada ainda.</p>
        </div>
        <% } else { %>
          <table class="table mb-0">
            <thead>
              <tr>
                <th>#</th>
                <th>Nome</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% categorias.forEach(function(c) { %>
                <tr>
                  <td class="text-muted">#<%= c.id %>
                  </td>
                  <td>
                    <%= c.nome %>
                  </td>
                  <td class="text-end">
                    <a href="/categorias/editar/<%= c.id %>" class="btn-icon edit me-1"><i class="bi bi-pencil"></i></a>
                    <a href="/categorias/excluir/<%= c.id %>" class="btn-icon trash"><i class="bi bi-trash"></i></a>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
          <% } %>
    </div>
  </div>
  <%- include('../partials/footer') %>